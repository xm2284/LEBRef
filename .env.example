# Copy this file to .env and edit paths for your machine.
# Do not commit .env.

# Dataset roots. Obtain the datasets from their original sources/licenses.
SMARTFALLMM_ROOT=./data/smartfallmm_selected
UMAFALL_ROOT=./data/umafall_corrected

# Frozen representation dependencies.
UNIMTS_CODE_DIR=./artifacts/UniMTS-main
GATE2A_CODE_DIR=./artifacts/gate2a_code
RELEASED_CHECKPOINT=./artifacts/checkpoints/UniMTS.pth
WEDA_CHECKPOINT=./artifacts/checkpoints/weda_fold0_acc_seed0_best_model.pth

# Cached frozen features. These can be regenerated if the data and checkpoints are available.
SMARTFALLMM_CACHE=./artifacts/feature_cache/smartfallmm
UMAFALL_CACHE=./artifacts/feature_cache/umafall

# V9 trained-head results are required for V19 no-retraining diagnostics.
V9_RESULTS_DIR=./artifacts/v9_results

# Directory written by the locked V6 pipeline (esra_ablation + locked_alarm_duty_audit).
# Required by run_experiment_v9.py --v6-results-dir. Not committed; see docs/DATA_AND_ARTIFACTS.md.
V6_RESULTS_DIR=./artifacts/v6_results

# Repository source locations.
V6_CODE_DIR=./src/core
EXTERNAL_CODE_DIR=./src/external
LINEAR_CORE=./src/linear_event/linear_event_core_v9.py

# Output.
FINAL_OUTPUT_ROOT=./outputs/v19_closure
FINAL_DEVICE=cpu
BOOTSTRAP_ITERATIONS=10000
